<Window x:Class="Skimmer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RTL-SDR V4 FT8 Skimmer" Height="820" Width="1400" MinWidth="1000" MinHeight="600"
        Background="#15181E" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#22262E"/><Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3A3F4A"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D333D"/><Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3A3F4A"/><Setter Property="Padding" Value="10,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Γραμμή ρυθμίσεων -->
        <WrapPanel Grid.Row="0" Margin="8,8,8,4">
            <TextBlock Text="Callsign" Margin="0,0,6,0"/>
            <TextBox x:Name="CallBox" Width="90" CharacterCasing="Upper" FontWeight="SemiBold"/>
            <TextBlock Text="Locator" Margin="14,0,6,0"/>
            <TextBox x:Name="GridBox" Width="70"/>
            <TextBlock Text="Gain" Margin="14,0,6,0"/>
            <ComboBox x:Name="GainBox" Width="90"/>
            <TextBlock Text="ppm" Margin="14,0,6,0"/>
            <TextBox x:Name="PpmBox" Width="40"/>
            <CheckBox x:Name="BiasTeeBox" Content="Bias-T" Margin="14,0,0,0"/>
            <TextBlock Text="Slots/band" Margin="14,0,6,0"/>
            <ComboBox x:Name="DwellBox" Width="45" SelectedIndex="0">
                <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/>
            </ComboBox>
            <TextBlock Text="jt9" Margin="14,0,6,0"/>
            <TextBox x:Name="Jt9Box" Width="230"/>
            <Button Content="…" Margin="4,0,0,0" Padding="6,1" Click="BrowseJt9_Click"/>
            <CheckBox x:Name="PskBox" Content="PSKReporter" Margin="14,0,0,0"/>
            <CheckBox x:Name="PskTestBox" Content="test server" Margin="8,0,0,0"/>
            <Button x:Name="StartButton" Content="▶ Start" Margin="16,0,0,0" FontWeight="SemiBold" Click="Start_Click"/>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="560"/>
            </Grid.ColumnDefinitions>

            <!-- Ζώνες -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Bands" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#8A92A0" FontSize="11" Margin="0,8,0,0"
                           Text="Below 28.8 MHz the V4 uses its built-in upconverter. Connect an HF antenna."/>
                <ItemsControl x:Name="BandList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="4" Padding="4,3" Margin="0,1">
                                <DockPanel>
                                    <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="#8A92A0"/>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" IsEnabled="{Binding Editable}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Active}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#2F4F2F"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Χάρτης και waterfall -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="#3A3F4A" BorderThickness="1">
                    <wv2:WebView2 x:Name="Map"/>
                </Border>
                <DockPanel Grid.Row="1" Margin="0,6,0,2">
                    <TextBlock x:Name="WfLabel" Text="Waterfall" FontWeight="SemiBold"/>
                    <TextBlock Text="0 Hz" Margin="12,0,0,0" Foreground="#8A92A0" FontSize="11"/>
                    <TextBlock Text="3000 Hz" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#8A92A0" FontSize="11"/>
                    <TextBlock/>
                </DockPanel>
                <Border Grid.Row="2" BorderBrush="#3A3F4A" BorderThickness="1" Background="Black">
                    <Image x:Name="WfImage" Stretch="Fill" RenderOptions.BitmapScalingMode="LowQuality"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Αποκωδικοποιήσεις -->
            <DataGrid x:Name="Decodes" Grid.Column="3" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                      Background="#1A1D23" RowBackground="#1A1D23" AlternatingRowBackground="#1F232A"
                      Foreground="#E6E6E6" BorderBrush="#3A3F4A" FontFamily="Consolas" FontSize="12"
                      CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#22262E"/><Setter Property="Foreground" Value="#C0C6D0"/>
                        <Setter Property="Padding" Value="6,3"/><Setter Property="FontFamily" Value="Segoe UI"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ForMe}" Value="True">
                                <Setter Property="Background" Value="#5A2A2A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCq}" Value="True">
                                <Setter Property="Foreground" Value="#8FE38F"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="UTC" Binding="{Binding Time}" Width="62"/>
                    <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="44"/>
                    <DataGridTextColumn Header="dB" Binding="{Binding Snr}" Width="34"/>
                    <DataGridTextColumn Header="DT" Binding="{Binding Dt}" Width="36"/>
                    <DataGridTextColumn Header="Hz" Binding="{Binding Hz}" Width="42"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                    <DataGridTextColumn Header="km" Binding="{Binding Km}" Width="52"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Γραμμή κατάστασης -->
        <Border Grid.Row="2" Background="#0F1115" Padding="8,4">
            <DockPanel>
                <TextBlock x:Name="CallLabel" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="#A8B0BC"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
