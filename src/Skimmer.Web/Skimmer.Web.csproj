<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>rtlft8skimmer</AssemblyName>
    <RootNamespace>Skimmer.Web</RootNamespace>
    <Version>0.2.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Skimmer.Core/Skimmer.Core.csproj" />
    <EmbeddedResource Include="wwwroot/index.html" LogicalName="index.html" />
    <Content Remove="wwwroot/**" />
    <None Include="native/*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Condition="Exists('native')" />
  </ItemGroup>
</Project>
